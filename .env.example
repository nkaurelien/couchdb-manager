# CouchDB Manager Configuration
# Copy this file to .env and update with your actual credentials

# Source CouchDB Configuration
# This is typically your local or development CouchDB instance
SOURCE_COUCHDB_URL=http://localhost:5984
SOURCE_COUCHDB_USER=admin
SOURCE_COUCHDB_PASSWORD=your_source_password

# Target CouchDB Configuration
# This is typically your remote or production CouchDB instance
TARGET_COUCHDB_URL=https://remote-couchdb.example.com:5984
TARGET_COUCHDB_USER=admin
TARGET_COUCHDB_PASSWORD=your_target_password

# Optional Configuration
# DEBUG=true  # Enable debug logging (uncomment to activate)
# BATCH_SIZE=100  # Number of documents to process in each batch
# BACKUP_DIR=./backups  # Directory to store backups (default: ./backups)